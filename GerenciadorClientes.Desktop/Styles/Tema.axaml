<!-- Tema escuro. As cores saem todas da paleta de 16 do projeto.
     Quando existir o botao de trocar tema, basta outro arquivo como este
     com os mesmos nomes e cores diferentes. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontePixel">avares://GerenciadorClientes.Desktop/Assets/Fonts#monogram</FontFamily>

    <!-- Fundos -->
    <SolidColorBrush x:Key="FundoJanela"   Color="#05090F" />
    <SolidColorBrush x:Key="Painel"        Color="#19252E" />
    <SolidColorBrush x:Key="PainelLuz"     Color="#324D4B" />
    <SolidColorBrush x:Key="PainelSombra"  Color="#05090F" />
    <SolidColorBrush x:Key="Cabecalho"     Color="#324D4B" />

    <!-- Menu lateral -->
    <SolidColorBrush x:Key="Menu"          Color="#19252E" />
    <SolidColorBrush x:Key="MenuLuz"       Color="#324D4B" />
    <SolidColorBrush x:Key="MenuTexto"     Color="#CCCBC2" />
    <SolidColorBrush x:Key="MenuFraco"     Color="#5F6B4B" />

    <!-- Texto -->
    <SolidColorBrush x:Key="Texto"         Color="#CCCBC2" />
    <SolidColorBrush x:Key="TextoFraco"    Color="#7F8A75" />
    <SolidColorBrush x:Key="Contorno"      Color="#05090F" />
    <SolidColorBrush x:Key="Linha"         Color="#05090F" />

    <!-- Destaques -->
    <SolidColorBrush x:Key="Selecao"       Color="#877920" />
    <SolidColorBrush x:Key="SelecaoTexto"  Color="#05090F" />
    <SolidColorBrush x:Key="Etiqueta"      Color="#4E7B87" />
    <SolidColorBrush x:Key="Verde"         Color="#208763" />
    <SolidColorBrush x:Key="Vinho"         Color="#87203F" />

</ResourceDictionary>
