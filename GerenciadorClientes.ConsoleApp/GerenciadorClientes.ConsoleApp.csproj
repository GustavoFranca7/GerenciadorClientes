<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe: este e o projeto que possui o metodo Main e realmente executa. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia a camada Core: e dela que vem os Models e os DAOs.
         A dependencia aponta em um sentido so - a Core nao conhece este
         projeto, e por isso nao consegue escrever nada na tela. -->
    <ProjectReference Include="..\GerenciadorClientes.Core\GerenciadorClientes.Core.csproj" />
  </ItemGroup>

</Project>
