<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Sem a tag <OutputType>, o SDK gera uma Class Library (.dll) em vez de
         um executavel. Esta camada nao roda sozinha: ela existe para ser
         consumida por outros projetos (o ConsoleApp hoje, o Avalonia no futuro). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>d30947ba-63d6-4935-8961-9a0e9b4d4a35</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- O driver do Oracle fica aqui, e nao na camada de apresentacao,
         porque e a Core quem conversa com o banco de dados. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
  </ItemGroup>

</Project>
